# Copy this file to .env and fill in what you use. Never commit .env.

# Which fetcher to use: "direct" (free, low volume, learning only) or "scraperapi"
FETCHER=direct

# Only needed when FETCHER=scraperapi  (https://www.scraperapi.com)
SCRAPERAPI_KEY=

# Only needed for --sheet: the Google Sheet ID (the long part of its URL)
GOOGLE_SHEET_ID=
# Path to the service-account JSON key you downloaded from Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Phase 4 (--ai): which LLM reads the job descriptions
LLM_PROVIDER=anthropic
# Create a key at https://platform.claude.com (API credit is billed separately from a Claude subscription)
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default, most accurate) or claude-haiku-5-5 (much cheaper, fine for extraction)
LLM_MODEL=claude-opus-5-5
# Phase 6 (--tailor): the cheaper model that fact-checks each tailored resume
VERIFIER_MODEL=claude-haiku-5-5

# Phase 7a: database (default: tracker.db in this folder) and API port
# DATABASE_URL=sqlite:///tracker.db
# API_PORT=8000
# Phase 7c: how long slow MCP tools wait before handing back a run ID
# MCP_WAIT_SECONDS=45

# Phase 7d: the agents (job-tracker-agent). Key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# Model for the agents (default: the SDK's default OpenAI model)
# AGENT_MODEL=gpt-5.6-luna
# Tracing: Langfuse instead of the OpenAI dashboard (needs: uv sync --extra tracing)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# AGENT_TRACING=off            record nothing
# AGENT_TRACE_CONTENT=off      record the steps but not the text (postings, your resume)
