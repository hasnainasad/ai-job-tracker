# Copy this file to .env and fill in what you use. Never commit .env.

# Which fetcher to use: "direct" (free, low volume, learning only) or "scraperapi"
FETCHER=direct

# Only needed when FETCHER=scraperapi  (https://www.scraperapi.com)
SCRAPERAPI_KEY=

# Only needed for --sheet: the Google Sheet ID (the long part of its URL)
GOOGLE_SHEET_ID=
# Path to the service-account JSON key you downloaded from Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
